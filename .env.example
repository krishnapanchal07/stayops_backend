APP_NAME=StayOps API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://krishna_stayops:<DB_PASS>@localhost:5432/stayops_db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET_KEY=<REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=20
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<EMAIL>
SMTP_PASSWORD=<APP_PASSWORD>
SMTP_FROM_EMAIL=<EMAIL>
SMTP_USE_TLS=true
RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
# Paste only your Razorpay Test Mode keys into the ignored .env file.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
